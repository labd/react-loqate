{
  "name": "react-loqate",
  "version": "3.1.3",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "license": "MIT",
  "author": "Bram Kaashoek",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./dist/index.css": "./dist/index.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/labd/react-loqate.git"
  },
  "keywords": [
    "loqate",
    "react"
  ],
  "packageManager": "pnpm@12.12.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsdown",
    "check": "pnpm lint && tsc",
    "dev": "storybook dev -p 6006",
    "format": "biome check --write",
    "lint": "eslint src && biome check",
    "prepare": "husky",
    "publish:ci": "pnpm build && pnpm changeset publish",
    "publish:version": "pnpm changeset version && pnpm format",
    "test": "vitest --passWithNoTests",
    "test:ci": "vitest run --passWithNoTests",
    "typecheck": "tsc"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "husky": {
    "hooks": {
      "pre-commit": "pnpm check"
    }
  },
  "lint-staged": {
    "*": [
      "biome check --write --no-errors-on-unmatched --files-ignore-unknown=true"
    ]
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@changesets/changelog-github": "1.0.1",
    "@changesets/cli": "3.0.3",
    "@chromatic-com/storybook": "5.4.0",
    "@storybook/addon-docs": "10.6.2",
    "@storybook/addon-links": "10.6.2",
    "@storybook/addon-onboarding": "10.6.2",
    "@storybook/react-vite": "10.6.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@tsdown/css": "^0.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@typescript-eslint/parser": "^8.71.1",
    "@vitest/coverage-v8": "5.0.3",
    "eslint": "^10.12.0",
    "eslint-plugin-storybook": "10.6.2",
    "husky": "9.1.7",
    "jsdom": "30.1.2",
    "lint-staged": "^17.6.0",
    "msw": "3.0.3",
    "publint": "^0.3.25",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "storybook": "10.6.2",
    "tsdown": "^0.23.1",
    "typescript": "^6.0.3",
    "vitest": "5.0.3"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "dependencies": {
    "clsx": "2.1.1"
  }
}
